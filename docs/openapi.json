{
  "components": {
    "schemas": {
      "BalanceResponse": {
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "available": {
            "title": "Available",
            "type": "integer"
          },
          "balance": {
            "title": "Balance",
            "type": "integer"
          },
          "consistency": {
            "default": "eventual",
            "title": "Consistency",
            "type": "string"
          },
          "held": {
            "title": "Held",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "account_id",
          "balance",
          "held",
          "available",
          "version"
        ],
        "title": "BalanceResponse",
        "type": "object"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "description": "One account command; ``command_id`` is the caller-owned idempotency key.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          },
          "type": {
            "enum": [
              "deposit",
              "withdraw"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "type",
          "amount",
          "expected_version"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "storage": {
            "additionalProperties": true,
            "title": "Storage",
            "type": "object"
          }
        },
        "required": [
          "status",
          "storage"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HoldRequest": {
        "additionalProperties": false,
        "description": "Reserve funds on the path account for ``target_account_id`` (ADR-0014).\n\n``ttl_seconds`` (bounded by ``CLOUDSCALE_HOLD_MAX_TTL_SECONDS``) is part of\nthe idempotent request; the decision stamps the absolute ``expires_at``\nfrom its clock. The hold id is the ``command_id``.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          },
          "target_account_id": {
            "title": "Target Account Id",
            "type": "string"
          },
          "ttl_seconds": {
            "title": "Ttl Seconds",
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "target_account_id",
          "amount",
          "expected_version",
          "ttl_seconds"
        ],
        "title": "HoldRequest",
        "type": "object"
      },
      "LegRequest": {
        "additionalProperties": false,
        "description": "One leg of a posting set (ADR-0013).",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "direction": {
            "enum": [
              "debit",
              "credit"
            ],
            "title": "Direction",
            "type": "string"
          }
        },
        "required": [
          "account_id",
          "amount",
          "direction"
        ],
        "title": "LegRequest",
        "type": "object"
      },
      "PostHoldRequest": {
        "additionalProperties": false,
        "description": "Settle a hold; ``amount`` omitted captures the full held amount.",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "expected_version"
        ],
        "title": "PostHoldRequest",
        "type": "object"
      },
      "PostingsRequest": {
        "additionalProperties": false,
        "description": "Commit 2..MAX_LEGS balanced legs atomically; the path account is the anchor.\n\nThe anchor must be one of the debited legs and is the only stream whose\n``expected_version`` the caller supplies. Validation (balance, duplicate\naccounts, leg count, anchor debited) is the domain's; failures are 400s\nwith the domain code.",
        "properties": {
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/LegRequest"
            },
            "title": "Postings",
            "type": "array"
          }
        },
        "required": [
          "command_id",
          "postings",
          "expected_version"
        ],
        "title": "PostingsRequest",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": true,
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RegisterAccountRequest": {
        "additionalProperties": false,
        "description": "Claim ownership of an account id for the authenticated caller.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "title": "RegisterAccountRequest",
        "type": "object"
      },
      "ReleaseHoldRequest": {
        "additionalProperties": false,
        "description": "Void an open hold.",
        "properties": {
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "command_id",
          "expected_version"
        ],
        "title": "ReleaseHoldRequest",
        "type": "object"
      },
      "TransferRequest": {
        "additionalProperties": false,
        "description": "Move ``amount`` from the path account to ``target_account_id`` (ADR-0011).\n\n``expected_version`` is the source stream's version; the target has no\nclient-supplied guard.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          },
          "target_account_id": {
            "title": "Target Account Id",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "target_account_id",
          "amount",
          "expected_version"
        ],
        "title": "TransferRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "cloudscale-backend",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/accounts": {
      "post": {
        "description": "Bind an account to the caller. Idempotent for the same caller.",
        "operationId": "register_account_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already registered to this caller (idempotent)."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "invalid_account_id."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "Registered to a different subject."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "501": {
            "description": "Registration not enabled in this deployment."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register Account"
      }
    },
    "/v1/accounts/{account_id}/balance": {
      "get": {
        "operationId": "get_balance_v1_accounts__account_id__balance_get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "404": {
            "description": "No event projected yet for this account; poll after a write."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get Balance"
      }
    },
    "/v1/accounts/{account_id}/commands": {
      "post": {
        "operationId": "post_command_v1_accounts__account_id__commands_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Command"
      }
    },
    "/v1/accounts/{account_id}/holds": {
      "post": {
        "description": "Reserve funds now for a later posting (ADR-0014). The hold id is the command id.\n\nChecked against AVAILABLE funds (balance minus open holds). The target\nlearns nothing until the hold is posted; its stream is untouched.",
        "operationId": "post_hold_v1_accounts__account_id__holds_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code (hold_not_open, hold_expired, capture_exceeds_hold, same_account, amount_out_of_range), or an invalid ttl_seconds."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict (source stream) or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds (available, not balance)."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Hold"
      }
    },
    "/v1/accounts/{account_id}/holds/{hold_id}/post": {
      "post": {
        "description": "Settle an open hold: debit the source, credit the hold's target (ADR-0014).\n\nA smaller ``amount`` captures part and releases the remainder in the\nsame transaction. The target posting's ``committed_version`` is\nredacted unless the caller may read that account.",
        "operationId": "post_hold_capture_v1_accounts__account_id__holds__hold_id__post_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "hold_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Hold Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostHoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code (hold_not_open, hold_expired, capture_exceeds_hold, same_account, amount_out_of_range), or an invalid ttl_seconds."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict (source stream) or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds (available, not balance)."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Hold Capture"
      }
    },
    "/v1/accounts/{account_id}/holds/{hold_id}/void": {
      "post": {
        "description": "Release an open hold without moving funds (ADR-0014).",
        "operationId": "post_hold_void_v1_accounts__account_id__holds__hold_id__void_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "hold_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Hold Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseHoldRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code (hold_not_open, hold_expired, capture_exceeds_hold, same_account, amount_out_of_range), or an invalid ttl_seconds."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict (source stream) or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds (available, not balance)."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Hold Void"
      }
    },
    "/v1/accounts/{account_id}/postings": {
      "post": {
        "description": "Commit a balanced N-leg posting set in one transaction (ADR-0013).\n\nAuthorization is on the anchor (the path account), which must be a\ndebited leg. Every other leg's ``committed_version`` is redacted unless\nthe caller may read that account.",
        "operationId": "post_postings_v1_accounts__account_id__postings_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code, or an invalid posting set: unbalanced, duplicate_account, too_many_legs, anchor_not_debited."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict (anchor stream) or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds on a debited leg."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Postings"
      }
    },
    "/v1/accounts/{account_id}/transfers": {
      "post": {
        "description": "Move funds from the path account to ``target_account_id`` (ADR-0011).\n\nAuthorization is on the source only: money leaves the caller's\naccount; the target may be any account, exactly as a deposit may\ncreate one. The target posting's ``committed_version`` is redacted\nunless the caller may read that account.",
        "operationId": "post_transfer_v1_accounts__account_id__transfers_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code, or a request naming the same account twice (same_account)."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict (source stream) or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds on the source."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Transfer"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }

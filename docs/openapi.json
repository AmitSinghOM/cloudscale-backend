{
  "components": {
    "schemas": {
      "BalanceResponse": {
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          },
          "balance": {
            "title": "Balance",
            "type": "integer"
          },
          "consistency": {
            "default": "eventual",
            "title": "Consistency",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "account_id",
          "balance",
          "version"
        ],
        "title": "BalanceResponse",
        "type": "object"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "description": "One account command; ``command_id`` is the caller-owned idempotency key.",
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "command_id": {
            "format": "uuid",
            "title": "Command Id",
            "type": "string"
          },
          "expected_version": {
            "title": "Expected Version",
            "type": "integer"
          },
          "type": {
            "enum": [
              "deposit",
              "withdraw"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "command_id",
          "type",
          "amount",
          "expected_version"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "storage": {
            "additionalProperties": true,
            "title": "Storage",
            "type": "object"
          }
        },
        "required": [
          "status",
          "storage"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": true,
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RegisterAccountRequest": {
        "additionalProperties": false,
        "description": "Claim ownership of an account id for the authenticated caller.",
        "properties": {
          "account_id": {
            "title": "Account Id",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "title": "RegisterAccountRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "cloudscale-backend",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/accounts": {
      "post": {
        "description": "Bind an account to the caller. Idempotent for the same caller.",
        "operationId": "register_account_v1_accounts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already registered to this caller (idempotent)."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "invalid_account_id."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "Registered to a different subject."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "501": {
            "description": "Registration not enabled in this deployment."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Register Account"
      }
    },
    "/v1/accounts/{account_id}/balance": {
      "get": {
        "operationId": "get_balance_v1_accounts__account_id__balance_get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "404": {
            "description": "No event projected yet for this account; poll after a write."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get Balance"
      }
    },
    "/v1/accounts/{account_id}/commands": {
      "post": {
        "operationId": "post_command_v1_accounts__account_id__commands_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Idempotent replay of a previously accepted command_id."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "CommandResult with outcome=domain_rejected and error_code."
          },
          "401": {
            "description": "Missing, invalid or expired bearer token (fixed message)."
          },
          "403": {
            "description": "Token valid but not authorized for this account."
          },
          "409": {
            "description": "CommandResult: version_conflict or command_id_conflict."
          },
          "422": {
            "description": "CommandResult: insufficient_funds."
          },
          "429": {
            "description": "Rate limit exceeded; honour Retry-After."
          },
          "503": {
            "description": "Command path unavailable; retry with the SAME command_id after Retry-After."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Post Command"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/ready": {
      "get": {
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    }
  }
}

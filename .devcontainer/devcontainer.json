{
  "name": "cloudscale-backend",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "make install-dev && .venv/bin/python -c 'import cloudscale; print(\"ready\")'",
  "postAttachCommand": "echo 'Quickstart: make dev && make token ARGS=--curl   |   PostgreSQL shape: docker compose up --build'",
  "forwardPorts": [8000, 9100],
  "portsAttributes": {
    "8000": { "label": "cloudscale API (/docs, /v1/ready, /metrics)" },
    "9100": { "label": "consumer metrics" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },
  "remoteEnv": {
    "CLOUDSCALE_TEST_PG": ""
  }
}
